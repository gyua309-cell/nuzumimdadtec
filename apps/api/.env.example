# Copy to .env and adjust. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
# Dev database started by `npm run db:start` (tools/devdb). Production: point to your PostgreSQL server.
DATABASE_URL=postgres://idham_owner:idham_dev_only_password@127.0.0.1:54329/idham
TEST_DATABASE_URL=postgres://idham_owner:idham_dev_only_password@127.0.0.1:54329/idham_test
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
