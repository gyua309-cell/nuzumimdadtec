{
  "name": "idham-erp",
  "version": "0.1.0",
  "private": true,
  "description": "IDHAM HR ACCOUNTING ERP - إدهام موارد بشرية المحاسبي",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "db:start": "npm run start -w @idham/devdb",
    "db:stop": "npm run stop -w @idham/devdb",
    "db:migrate": "npm run migrate -w @idham/api",
    "seed": "node tools/seed_demo_data.js",
    "dev:api": "npm run start:dev -w @idham/api",
    "dev:web": "npm run dev -w @idham/web",
    "test": "npm run test -w @idham/api",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
